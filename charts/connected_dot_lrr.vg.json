{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected dot plot comparing 2024-25 RSPCA dog and cat live release rates by state/territory.",
  "width": "container",
  "height": 410,
  "background": "#ffffff",
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "title": {
    "text": "How wide is the dog–cat live-release gap?",
    "subtitle": [
      "Each horizontal segment connects dogs and cats within the same RSPCA jurisdiction.",
      "States are ordered by the absolute size of the gap."
    ],
    "anchor": "start",
    "fontSize": 24,
    "subtitleFontSize": 13,
    "subtitlePadding": 8,
    "offset": 14
  },
  "data": {
    "url": "data/chart4_dog_cat_lrr.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rate": "number",
        "gap_pp": "number",
        "abs_gap_pp": "number",
        "species_order": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "state_name",
      "type": "nominal",
      "sort": [
        "Tasmania",
        "Western Australia",
        "Queensland",
        "New South Wales",
        "South Australia",
        "Victoria",
        "Australian Capital Territory",
        "Northern Territory"
      ],
      "title": null,
      "axis": {
        "labelFontSize": 13,
        "labelLimit": 170,
        "ticks": false,
        "domain": false,
        "labelPadding": 8
      }
    },
    "x": {
      "field": "rate",
      "type": "quantitative",
      "scale": {
        "domain": [
          0.65,
          0.98
        ],
        "nice": false
      },
      "axis": {
        "title": "Live release rate",
        "format": ".0%",
        "values": [
          0.65,
          0.7,
          0.75,
          0.8,
          0.85,
          0.9,
          0.95
        ],
        "grid": true,
        "gridColor": "#e7eeec",
        "domain": false,
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titlePadding": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "stroke": "#bcc9cb",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "state_name",
          "type": "nominal"
        },
        "order": {
          "field": "species_order",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 175,
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      },
      "encoding": {
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Dogs",
              "Cats"
            ],
            "range": [
              "#173642",
              "#3f7f80"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "species",
            "type": "nominal",
            "title": "Animal"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Live release rate",
            "format": ".1%"
          },
          {
            "field": "gap_pp",
            "type": "quantitative",
            "title": "Dog − cat gap (pp)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Source Sans 3, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Source Sans 3, Arial, sans-serif",
      "subtitleFont": "Source Sans 3, Arial, sans-serif"
    },
    "axis": {
      "labelColor": "#40555d",
      "titleColor": "#40555d"
    }
  }
}