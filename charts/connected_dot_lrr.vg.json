{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected dot plot comparing 2024-25 RSPCA dog and cat live release rates by state/territory.",
  "width": "container",
  "height": 400,
  "background": "#ffffff",
  "title": {
    "text": "How wide is the dog–cat live-release gap?",
    "subtitle": [
      "Each line connects dogs and cats within the same RSPCA state/territory network.",
      "States are ordered by the size of the dog–cat gap."
    ],
    "anchor": "start",
    "fontSize": 24,
    "subtitleFontSize": 13,
    "subtitlePadding": 8,
    "offset": 14
  },
  "data": {
    "url": "data/chart4_dog_cat_lrr.csv",
    "format": {
      "type": "csv",
      "parse": {
        "dog_lrr": "number",
        "cat_lrr": "number",
        "gap_pp": "number",
        "abs_gap_pp": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#bcc9cb",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "state_name",
          "type": "nominal",
          "sort": [
            "Tasmania",
            "Western Australia",
            "Queensland",
            "New South Wales",
            "South Australia",
            "Victoria",
            "Australian Capital Territory",
            "Northern Territory"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "labelLimit": 165,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "cat_lrr",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.65,
              0.98
            ],
            "nice": false
          },
          "axis": {
            "title": "Live release rate",
            "format": ".0%",
            "values": [
              0.65,
              0.7,
              0.75,
              0.8,
              0.85,
              0.9,
              0.95
            ],
            "grid": true,
            "gridColor": "#e7eeec",
            "domain": false,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titlePadding": 12
          }
        },
        "x2": {
          "field": "dog_lrr"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "color": "#173642",
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      },
      "encoding": {
        "y": {
          "field": "state_name",
          "type": "nominal",
          "sort": [
            "Tasmania",
            "Western Australia",
            "Queensland",
            "New South Wales",
            "South Australia",
            "Victoria",
            "Australian Capital Territory",
            "Northern Territory"
          ],
          "title": null
        },
        "x": {
          "field": "dog_lrr",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.65,
              0.98
            ],
            "nice": false
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "dog_lrr",
            "type": "quantitative",
            "title": "Dogs",
            "format": ".1%"
          },
          {
            "field": "cat_lrr",
            "type": "quantitative",
            "title": "Cats",
            "format": ".1%"
          },
          {
            "field": "gap_pp",
            "type": "quantitative",
            "title": "Dog − cat gap (pp)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "color": "#3f7f80",
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      },
      "encoding": {
        "y": {
          "field": "state_name",
          "type": "nominal",
          "sort": [
            "Tasmania",
            "Western Australia",
            "Queensland",
            "New South Wales",
            "South Australia",
            "Victoria",
            "Australian Capital Territory",
            "Northern Territory"
          ],
          "title": null
        },
        "x": {
          "field": "cat_lrr",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.65,
              0.98
            ],
            "nice": false
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "dog_lrr",
            "type": "quantitative",
            "title": "Dogs",
            "format": ".1%"
          },
          {
            "field": "cat_lrr",
            "type": "quantitative",
            "title": "Cats",
            "format": ".1%"
          },
          {
            "field": "gap_pp",
            "type": "quantitative",
            "title": "Dog − cat gap (pp)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "font": "Source Sans 3, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Source Sans 3, Arial, sans-serif",
      "subtitleFont": "Source Sans 3, Arial, sans-serif"
    },
    "axis": {
      "labelColor": "#40555d",
      "titleColor": "#40555d"
    }
  }
}