{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "RSPCA 2024-25 live release rate by Australian state/territory and species, using local state geometry.",
  "width": "container",
  "height": 520,
  "background": "#ffffff",
  "title": {
    "text": "Where do live-release outcomes differ most?",
    "subtitle": [
      "RSPCA 2024–25. LRR counts animals rehomed, reunited or transferred among eligible outcomes.",
      "Select dogs or cats. These figures describe the RSPCA network, not every Australian shelter."
    ],
    "anchor": "start",
    "fontSize": 24,
    "subtitleFontSize": 13,
    "subtitlePadding": 8,
    "offset": 14
  },
  "params": [
    {
      "name": "Species_selection",
      "value": "Dog",
      "bind": {
        "input": "select",
        "options": [
          "Dog",
          "Cat"
        ],
        "labels": [
          "Dogs",
          "Cats"
        ],
        "name": "Animal: "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "data/australia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "states"
    }
  },
  "transform": [
    {
      "filter": "datum.properties.STATE_CODE != '9'"
    },
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/map1_state_lrr_wide.csv",
          "format": {
            "type": "csv",
            "parse": {
              "dog_lrr": "number",
              "cat_lrr": "number",
              "dog_rehomed": "number",
              "cat_rehomed": "number",
              "dog_reunited": "number",
              "cat_reunited": "number",
              "dog_transferred": "number",
              "cat_transferred": "number",
              "dog_euthanased": "number",
              "cat_euthanased": "number",
              "dog_eligible": "number",
              "cat_eligible": "number"
            }
          }
        },
        "key": "state_name",
        "fields": [
          "state",
          "dog_lrr",
          "cat_lrr",
          "dog_rehomed",
          "cat_rehomed",
          "dog_reunited",
          "cat_reunited",
          "dog_transferred",
          "cat_transferred",
          "dog_euthanased",
          "cat_euthanased",
          "dog_eligible",
          "cat_eligible"
        ]
      }
    },
    {
      "calculate": "Species_selection == 'Dog' ? datum.dog_lrr : datum.cat_lrr",
      "as": "selected_lrr"
    },
    {
      "calculate": "Species_selection == 'Dog' ? datum.dog_rehomed : datum.cat_rehomed",
      "as": "selected_rehomed"
    },
    {
      "calculate": "Species_selection == 'Dog' ? datum.dog_reunited : datum.cat_reunited",
      "as": "selected_reunited"
    },
    {
      "calculate": "Species_selection == 'Dog' ? datum.dog_transferred : datum.cat_transferred",
      "as": "selected_transferred"
    },
    {
      "calculate": "Species_selection == 'Dog' ? datum.dog_euthanased : datum.cat_euthanased",
      "as": "selected_euthanased"
    },
    {
      "calculate": "Species_selection == 'Dog' ? datum.dog_eligible : datum.cat_eligible",
      "as": "selected_eligible"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "selected_lrr",
      "type": "quantitative",
      "title": "Live release rate",
      "scale": {
        "domain": [
          0.65,
          0.95
        ],
        "scheme": "blues",
        "clamp": true
      },
      "legend": {
        "format": ".0%",
        "gradientLength": 150,
        "titleLimit": 140,
        "labelLimit": 80,
        "orient": "right"
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "selected_lrr",
        "type": "quantitative",
        "title": "Live release rate",
        "format": ".1%"
      },
      {
        "field": "selected_rehomed",
        "type": "quantitative",
        "title": "Rehomed",
        "format": ","
      },
      {
        "field": "selected_reunited",
        "type": "quantitative",
        "title": "Reunited with owner",
        "format": ","
      },
      {
        "field": "selected_transferred",
        "type": "quantitative",
        "title": "Transferred",
        "format": ","
      },
      {
        "field": "selected_euthanased",
        "type": "quantitative",
        "title": "Euthanased",
        "format": ","
      },
      {
        "field": "selected_eligible",
        "type": "quantitative",
        "title": "Eligible outcomes",
        "format": ","
      }
    ]
  },
  "config": {
    "font": "Source Sans 3, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "title": {
      "font": "Source Sans 3, Arial, sans-serif",
      "subtitleFont": "Source Sans 3, Arial, sans-serif"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  }
}