{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mirrored bar comparison of reason composition by species.",
  "width": "container",
  "height": 330,
  "background": "#ffffff",
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "title": {
    "text": "How do the recorded reasons differ by species?",
    "subtitle": [
      "Shares are calculated within each species total.",
      "Dogs extend left from 0%; cats extend right."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitlePadding": 8,
    "offset": 12,
    "font": "Helvetica, Arial, sans-serif",
    "subtitleFont": "Helvetica, Arial, sans-serif"
  },
  "data": {
    "url": "data/chart5_compare.csv",
    "format": {
      "type": "csv",
      "parse": {
        "count": "number",
        "share": "number",
        "signed_share": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "reason",
      "type": "nominal",
      "sort": [
        "Behavioural",
        "Medical",
        "Infectious",
        "Other",
        "Legal"
      ],
      "title": null,
      "axis": {
        "labelFontSize": 13,
        "labelLimit": 120,
        "ticks": false,
        "domain": false,
        "labelPadding": 10
      }
    },
    "x": {
      "field": "signed_share",
      "type": "quantitative",
      "scale": {
        "domain": [
          -0.65,
          0.65
        ],
        "nice": false
      },
      "axis": {
        "title": "Share within species",
        "values": [
          -0.6,
          -0.4,
          -0.2,
          0,
          0.2,
          0.4,
          0.6
        ],
        "format": ".0%",
        "grid": true,
        "gridColor": "#e7eeec",
        "domain": false,
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titlePadding": 12
      }
    },
    "color": {
      "field": "species",
      "type": "nominal",
      "scale": {
        "domain": [
          "Dog",
          "Cat"
        ],
        "range": [
          "#235789",
          "#C46A2D"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "species",
        "type": "nominal",
        "title": "Animal"
      },
      {
        "field": "reason",
        "type": "nominal",
        "title": "Reason"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Count",
        "format": ","
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share",
        "format": ".1%"
      }
    ]
  },
  "config": {
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Helvetica, Arial, sans-serif",
      "subtitleFont": "Helvetica, Arial, sans-serif",
      "color": "#173642",
      "subtitleColor": "#607077"
    },
    "axis": {
      "labelColor": "#52666f",
      "titleColor": "#40555d",
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    },
    "legend": {
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar"
      }
    },
    {
      "transform": [
        {
          "filter": "datum.species == 'Dog' && datum.reason == 'Behavioural'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "font": "Helvetica, Arial, sans-serif",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#FFFFFF"
      },
      "encoding": {
        "text": {
          "value": "59.7%"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.species == 'Cat' && datum.reason == 'Medical'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "font": "Helvetica, Arial, sans-serif",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#173642"
      },
      "encoding": {
        "text": {
          "value": "46.7%"
        }
      }
    }
  ]
}
