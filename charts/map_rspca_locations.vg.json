{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Selected verified RSPCA shelter and adoption facilities across Australia.",
  "width": "container",
  "height": 520,
  "background": "#ffffff",
  "title": {
    "text": "Where are these selected RSPCA facilities located?",
    "subtitle": [
      "A selected, address-verified sample of RSPCA-operated care and adoption sites (not a complete facility census).",
      "Points locate example facilities only; they do not describe availability, capacity or access."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitlePadding": 8,
    "offset": 12,
    "font": "Helvetica, Arial, sans-serif",
    "subtitleFont": "Helvetica, Arial, sans-serif"
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STATE_CODE != '9'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f3f6f5",
        "stroke": "#cbd6d3",
        "strokeWidth": 0.9
      }
    },
    {
      "data": {
        "url": "data/map3_rspca_locations.csv",
        "format": {
          "type": "csv",
          "parse": {
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "size": 95,
        "opacity": 0.82,
        "color": "#63794A",
        "stroke": "#ffffff",
        "strokeWidth": 1.3,
        "tooltip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "facility",
            "type": "nominal",
            "title": "Facility"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Locality"
          },
          {
            "field": "address",
            "type": "nominal",
            "title": "Address"
          }
        ],
        "color": {
          "value": "#63794A"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "note": "18 verified examples"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Helvetica, Arial, sans-serif",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#173642",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": 12
        },
        "y": {
          "value": 44
        },
        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "note": "Selected sites, not a census"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Helvetica, Arial, sans-serif",
        "fontSize": 12,
        "fontWeight": "normal",
        "color": "#536B73",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": 12
        },
        "y": {
          "value": 65
        },
        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Helvetica, Arial, sans-serif",
      "subtitleFont": "Helvetica, Arial, sans-serif",
      "color": "#173642",
      "subtitleColor": "#607077"
    },
    "axis": {
      "labelColor": "#52666f",
      "titleColor": "#40555d",
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    },
    "legend": {
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  }
}
