{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Selected verified RSPCA shelter and adoption facilities across Australia.",
  "width": "container",
  "height": 520,
  "background": "#ffffff",
  "title": {
    "text": "Where are RSPCA shelter and adoption facilities located?",
    "subtitle": [
      "Each dot is a verified RSPCA-operated shelter, animal care centre or adoption centre from official state/territory pages.",
      "The map shows facility location, not capacity or animal intake."
    ],
    "anchor": "start",
    "fontSize": 24,
    "subtitleFontSize": 13,
    "subtitlePadding": 8,
    "offset": 14
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STATE_CODE != '9'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f3f6f5",
        "stroke": "#cbd6d3",
        "strokeWidth": 0.9
      }
    },
    {
      "data": {
        "url": "data/map3_rspca_locations.csv",
        "format": {
          "type": "csv",
          "parse": {
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "condition": {
            "param": "hover",
            "value": 210
          },
          "value": 95,
          "legend": null
        },
        "color": {
          "value": "#2f7f80"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 1
          },
          "value": 0.78
        },
        "tooltip": [
          {
            "field": "facility",
            "type": "nominal",
            "title": "Facility"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Locality"
          },
          {
            "field": "address",
            "type": "nominal",
            "title": "Address"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Source Sans 3, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Source Sans 3, Arial, sans-serif",
      "subtitleFont": "Source Sans 3, Arial, sans-serif"
    }
  }
}