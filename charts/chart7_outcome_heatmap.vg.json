  "params": [
    {
      "name": "speciesFilter",
      "value": "Dog",
      "bind": {
        "input": "select",
        "options": [
          "Dog",
          "Cat"
        ],
        "labels": [
          "Dogs",
          "Cats"
        ],
        "name": "Species: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.species == speciesFilter"
    },
    {
      "calculate": "datum.share_pct >= 35 ? 'white' : '#173042'",
      "as": "labelColor"
    }
  ],
  "title": {
    "text": "Which outcomes take up the largest share in each state?",
    "subtitle": "Heatmap shows the composition of recorded outcomes within each state. Use the selector to compare dogs and cats.",
    "anchor": "start",
    "font": "Helvetica, Arial, sans-serif",
    "subtitleFont": "Helvetica, Arial, sans-serif",
    "fontSize": 18,
    "subtitleFontSize": 12
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "share_pct",
          "type": "quantitative",
          "title": "Share of state outcomes (%)",
          "scale": {
            "domain": [
              0,
              80
            ],
            "range": [
              "#eff5f4",
              "#2e7f7c"
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 280,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "species",
            "type": "nominal",
            "title": "Species"
          },
          {
            "field": "outcome_group",
            "type": "nominal",
            "title": "Outcome"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Count",
            "format": ","
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Helvetica, Arial, sans-serif",
        "fontSize": 11,
        "baseline": "middle"
      },
      "encoding": {
        "text": {
          "field": "share_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.share_pct >= 45",
            "value": "#ffffff"
          },
          "value": "#173642"
        }
      }
    }
  ],
  "config": {
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
