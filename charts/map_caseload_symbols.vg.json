{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "RSPCA 2024-25 companion-animal caseload by Australian state/territory using local geometry and representative points.",
  "width": "container",
  "height": 520,
  "background": "#ffffff",
  "title": {
    "text": "Where did the RSPCA network record the largest caseload?",
    "subtitle": [
      "Circle area represents reported dogs, cats or both in 2024–25.",
      "Points are representative state/territory positions; totals describe RSPCA reporting coverage."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "subtitlePadding": 8,
    "offset": 12
  },
  "params": [
    {
      "name": "Caseload_selection",
      "value": "Companion",
      "bind": {
        "input": "select",
        "options": [
          "Companion",
          "Dog",
          "Cat"
        ],
        "labels": [
          "Dogs + cats",
          "Dogs",
          "Cats"
        ],
        "name": "Caseload: "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STATE_CODE != '9'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f5f6f6",
        "stroke": "#cad2d5",
        "strokeWidth": 0.9
      }
    },
    {
      "data": {
        "url": "data/map2_state_points.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/map2_state_caseload.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "dogs_total": "number",
                  "cats_total": "number",
                  "companion_total": "number"
                }
              }
            },
            "key": "state_name",
            "fields": [
              "dogs_total",
              "cats_total",
              "companion_total"
            ]
          }
        },
        {
          "calculate": "Caseload_selection == 'Dog' ? datum.dogs_total : Caseload_selection == 'Cat' ? datum.cats_total : datum.companion_total",
          "as": "selected_total"
        },
        {
          "calculate": "Caseload_selection == 'Dog' ? 'Dogs' : Caseload_selection == 'Cat' ? 'Cats' : 'Dogs + cats'",
          "as": "selected_label"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.78,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "selected_total",
          "type": "quantitative",
          "title": "Animals recorded",
          "scale": {
            "range": [
              160,
              4200
            ]
          },
          "legend": null
        },
        "color": {
          "value": "#5B7482"
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "selected_label",
            "type": "nominal",
            "title": "Shown"
          },
          {
            "field": "selected_total",
            "type": "quantitative",
            "title": "Animals recorded",
            "format": ","
          },
          {
            "field": "dogs_total",
            "type": "quantitative",
            "title": "Dogs",
            "format": ","
          },
          {
            "field": "cats_total",
            "type": "quantitative",
            "title": "Cats",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    },
    "title": {
      "font": "Helvetica, Arial, sans-serif",
      "subtitleFont": "Helvetica, Arial, sans-serif",
      "color": "#173642",
      "subtitleColor": "#607077"
    },
    "axis": {
      "labelColor": "#52666f",
      "titleColor": "#40555d",
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  }
}
