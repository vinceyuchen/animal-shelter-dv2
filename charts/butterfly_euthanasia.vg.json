{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Butterfly chart comparing national RSPCA 2024-25 euthanasia reason composition for dogs and cats.",
  "width": "container",
  "height": 330,
  "background": "#ffffff",
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "title": {
    "text": "Why are dogs and cats euthanased?",
    "subtitle": [
      "Shares are calculated within each species’ euthanasia total.",
      "Dogs extend left; cats extend right."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitlePadding": 8,
    "offset": 14,
    "font": "Helvetica, Arial, sans-serif",
    "subtitleFont": "Helvetica, Arial, sans-serif"
  },
  "data": {
    "url": "data/chart5_euthanasia_reasons.csv",
    "format": {
      "type": "csv",
      "parse": {
        "count": "number",
        "share": "number",
        "signed_share": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#b8c5c7",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "reason",
          "type": "nominal",
          "sort": [
            "Behavioural",
            "Medical",
            "Infectious",
            "Other",
            "Legal"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "labelLimit": 110,
            "ticks": false,
            "domain": false,
            "labelPadding": 10
          }
        },
        "x": {
          "field": "signed_share",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.65,
              0.65
            ],
            "nice": false
          },
          "axis": {
            "title": "Share of euthanasia reasons within species",
            "values": [
              -0.6,
              -0.4,
              -0.2,
              0,
              0.2,
              0.4,
              0.6
            ],
            "labelExpr": "format(abs(datum.value), '.0%')",
            "grid": true,
            "gridColor": "#e7eeec",
            "domain": false,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titlePadding": 12
          }
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Dog",
              "Cat"
            ],
            "range": [
              "#173642",
              "#3f7f80"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "species",
            "type": "nominal",
            "title": "Animal"
          },
          {
            "field": "reason",
            "type": "nominal",
            "title": "Reason"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Euthanased",
            "format": ","
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share within species",
            "format": ".1%"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Helvetica, Arial, sans-serif",
      "subtitleFont": "Helvetica, Arial, sans-serif"
    },
    "axis": {
      "labelColor": "#40555d",
      "titleColor": "#40555d",
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    },
    "legend": {
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    }
  }
}
