    "axis": {
      "labelColor": "#536B73",
      "titleColor": "#173642",
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    },
    "legend": {
      "labelColor": "#173642",
      "labelFont": "Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica, Arial, sans-serif"
    },
    "title": {
      "color": "#173642",
      "subtitleColor": "#607077",
      "font": "Helvetica, Arial, sans-serif",
      "subtitleFont": "Helvetica, Arial, sans-serif"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.92
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "title": "Month",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12
          }
        },
        "y": {
          "field": "mean_count",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "Adopted",
              "Reclaimed"
            ],
            "range": [
              "#76518F",
              "#91622F"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "labelFontSize": 13,
            "labelLimit": 140,
            "columns": 2
          }
        },
        "order": {
          "field": "series",
          "type": "nominal",
          "sort": [
            "Adopted",
            "Reclaimed"
          ]
        },
        "tooltip": [
          {
            "field": "month",
            "type": "nominal",
            "title": "Month"
          },
          {
            "field": "series",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "mean_count",
            "type": "quantitative",
            "title": "Average monthly records",
            "format": ",.1f"
          },
          {
            "field": "years",
            "type": "quantitative",
            "title": "Years averaged"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "max",
              "field": "mean_count",
              "as": "series_max"
            }
          ],
          "groupby": [
            "series"
          ],
          "frame": [
            null,
            null
          ]
        },
        {
          "filter": "datum.series === 'Reclaimed' && datum.mean_count === datum.series_max"
        },
        {
          "calculate": "'Reclaims peak · ' + datum.month + ' ' + format(datum.mean_count, '.1f')",
          "as": "peak_label"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Helvetica, Arial, sans-serif",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#FFFFFF",
        "stroke": "#173642",
        "strokeWidth": 0.5,
        "align": "center",
        "baseline": "middle",
        "dx": 0
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ]
        },
        "y": {
          "value": 85
        },
        "text": {
          "field": "peak_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "max",
              "field": "mean_count",
              "as": "series_max"
            }
          ],
          "groupby": [
            "series"
          ],
          "frame": [
            null,
            null
          ]
        },
        {
          "filter": "datum.series === 'Adopted' && datum.mean_count === datum.series_max"
        },
        {
          "calculate": "'Adoptions peak · ' + datum.month + ' ' + format(datum.mean_count, '.1f')",
          "as": "peak_label"
        }
      ],
      "mark": {
        "type": "text",
